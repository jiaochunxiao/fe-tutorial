---
import Base from './Base.astro';
interface Props { title: string; desc?: string }
const { title, desc } = Astro.props;
---
<Base title={title} desc={desc}>
  <div class="chrome-root">
  <header class="nav">
    <a class="mark" href="/">前端进阶之路</a>
    <a class="offer" href="#">上岸offer ↗</a>
    <button class="burger" aria-label="菜单" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <nav>
      <a href="/path">路线</a>
      <a href="/#all">系列</a>
      <a href="/search">搜索</a>
      <a href="/#feature">精读</a>
      <a href="/about">关于</a>
      <a href="https://max.jiaochunxiao.cn" target="_blank" rel="noopener">题库</a>
    </nav>
  </header>
  <script is:inline>
    (function () {
      var b = document.querySelector('.nav .burger');
      var nav = document.querySelector('.nav');
      if (!b || !nav) return;
      b.addEventListener('click', function () {
        var open = b.getAttribute('aria-expanded') === 'true';
        b.setAttribute('aria-expanded', String(!open));
        nav.classList.toggle('nav-open', !open);
      });
      nav.addEventListener('click', function (e) {
        if (e.target.tagName === 'A' && nav.classList.contains('nav-open')) {
          nav.classList.remove('nav-open');
          b.setAttribute('aria-expanded', 'false');
        }
      });
    })();
  </script>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div><b>前端进阶之路</b> · 与小程序「上岸offer」题库联动 · 思考题解析陆续录入</div>
      <div>19 系列 · 158 篇 · 300+ 原理图</div>
    </footer>
  </div>
</Base>
