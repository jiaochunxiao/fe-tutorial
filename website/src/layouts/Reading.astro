---
import Book from './Book.astro';

interface Props {
  title: string;
  desc?: string;
  seriesName?: string;
  seriesHref?: string;
}

const { title, desc, seriesName, seriesHref } = Astro.props;
---
<Book title={title} desc={desc} reading mainClass="reading-main">
  <div class="reading-page">
    <div class="reading-topline">
      <nav class="reading-crumb" aria-label="面包屑">
        <a href="/">课程书目</a>
        <span aria-hidden="true">/</span>
        {seriesName && seriesHref
          ? <a href={seriesHref} aria-current="page">{seriesName}</a>
          : <span>编者说明</span>}
      </nav>
      <nav class="reading-shortcuts" aria-label="阅读页面导航">
        <a href="/#directory">系列目录</a>
        <a href="/path">学习路线</a>
        <a href="/about">关于</a>
      </nav>
    </div>
    <slot />
  </div>
</Book>
