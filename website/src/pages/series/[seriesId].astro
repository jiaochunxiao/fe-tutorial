---
import { getCollection } from 'astro:content';
import Book from '../../layouts/Book.astro';
import { SERIES } from '../../data/series';
import { STAGE_NAMES, padNo, seriesName } from '../../utils/series';

export async function getStaticPaths() {
  const entries = await getCollection('articles');
  const bySeries = new Map<string, typeof entries>();
  for (const entry of entries) {
    const list = bySeries.get(entry.data.seriesId) ?? [];
    list.push(entry);
    bySeries.set(entry.data.seriesId, list);
  }

  return SERIES.map((meta, index) => ({
    params: { seriesId: meta.id },
    props: {
      meta,
      index,
      articles: (bySeries.get(meta.id) ?? []).sort((a, b) =>
        a.data.id.localeCompare(b.data.id)),
      prev: SERIES[index - 1] ?? null,
      next: SERIES[index + 1] ?? null,
    },
  }));
}

const { meta, index, articles, prev, next } = Astro.props;
const name = seriesName(meta.id);
const totalMinutes = articles.reduce((sum, article) => sum + article.data.readingTime, 0);
const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
---
<Book title={name} desc={meta.intro}>
  <header class="book-page-head series-head">
    <div>
      <div class="book-kicker">
        系列 {padNo(index + 1)} / {padNo(SERIES.length)} · {meta.stage} {STAGE_NAMES[meta.stage]} · {meta.en}
      </div>
      <h1 class="book-page-title">{name}</h1>
      <p class="book-page-lede">{meta.intro}</p>
    </div>

    <dl class="series-facts">
      <div><dt>所属阶段</dt><dd>{meta.stage} · {STAGE_NAMES[meta.stage]}</dd></div>
      <div><dt>本系列篇数</dt><dd>{articles.length} 篇</dd></div>
      <div><dt>标注阅读时长</dt><dd>{totalMinutes} 分钟</dd></div>
      <div><dt>学习方法</dt><dd>按序阅读，完成文末思考题</dd></div>
    </dl>
  </header>

  <section class="series-catalog" aria-labelledby="catalog-title">
    <div class="book-section-head series-catalog-head">
      <div>
        <div class="book-kicker">CONTENTS · 篇目</div>
        <h2 id="catalog-title">本系列目录</h2>
      </div>
      <p>难度来自课程标注，阅读时长为源文标注值。点击篇名进入正文。</p>
    </div>

    <div class="catalog-table">
      <div class="catalog-labels" aria-hidden="true">
        <span>篇目</span><span>难度</span><span>阅读</span>
      </div>
      {articles.map((article, articleIndex) => (
        <a class="catalog-row" href={`/articles/${article.data.id}/`}>
          <span class="catalog-no">{padNo(articleIndex + 1)}</span>
          <span class="catalog-title">{article.data.title}</span>
          <span class="catalog-stars" aria-label={`难度 ${article.data.difficulty} / 5`}>
            {stars(article.data.difficulty)}
          </span>
          <span class="catalog-time">{article.data.readingTime} 分钟</span>
        </a>
      ))}
    </div>
  </section>

  <nav class="series-pager" aria-label="系列翻页">
    {prev ? (
      <a class="series-pager-prev" href={`/series/${prev.id}/`}>
        <span>← 上一个系列</span>
        <b>{seriesName(prev.id)}</b>
      </a>
    ) : <span class="series-pager-empty">已经是第一个系列</span>}
    {next ? (
      <a class="series-pager-next" href={`/series/${next.id}/`}>
        <span>下一个系列 →</span>
        <b>{seriesName(next.id)}</b>
      </a>
    ) : <span class="series-pager-empty series-pager-next">已经是最后一个系列</span>}
  </nav>

  <div class="series-back">
    <a class="book-text-link" href="/#directory">返回全部系列目录</a>
  </div>
</Book>

<style>
  .series-head .book-page-title{font-size:clamp(44px,5.4vw,68px)}
  .series-facts{border-top:2px solid var(--book-ink)}
  .series-facts > div{
    display:grid;
    grid-template-columns:100px minmax(0,1fr);
    gap:14px;
    padding:10px 0;
    border-bottom:1px solid var(--book-hair);
  }
  .series-facts dt{color:var(--book-muted);font-size:12px}
  .series-facts dd{font-family:var(--book-serif);font-size:13.5px;font-weight:700;line-height:1.6}

  .series-catalog{padding-top:68px}
  .series-catalog-head{margin-bottom:20px}
  .catalog-table{border-top:2px solid var(--book-ink)}
  .catalog-labels{
    display:grid;
    grid-template-columns:52px minmax(0,1fr) 92px 80px;
    gap:18px;
    padding:8px 0;
    border-bottom:1px solid var(--book-hair);
    color:var(--book-muted);
    font-family:var(--book-mono);
    font-size:10px;
    letter-spacing:.08em;
  }
  .catalog-labels span:first-child{grid-column:1 / 3}
  .catalog-labels span:nth-child(2){grid-column:3}
  .catalog-labels span:nth-child(3){grid-column:4;text-align:right}
  .catalog-row{
    display:grid;
    grid-template-columns:52px minmax(0,1fr) 92px 80px;
    gap:18px;
    align-items:baseline;
    min-height:60px;
    padding:12px 0;
    border-bottom:1px solid var(--book-hair);
  }
  .catalog-no{color:var(--book-muted);font-family:var(--book-mono);font-size:11px}
  .catalog-title{font-family:var(--book-serif);font-size:16.5px;font-weight:700;line-height:1.6}
  .catalog-stars{color:var(--book-cinnabar);font-size:11px;letter-spacing:.04em;white-space:nowrap}
  .catalog-time{color:var(--book-muted);font-family:var(--book-mono);font-size:11px;text-align:right;white-space:nowrap}
  .catalog-row:hover .catalog-title{color:var(--book-cinnabar)}

  .series-pager{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:32px;
    margin-top:64px;
    padding-top:16px;
    border-top:1px solid var(--book-ink);
  }
  .series-pager a{display:block;min-height:62px}
  .series-pager a > span{display:block;color:var(--book-muted);font-size:12px}
  .series-pager a > b{
    display:block;
    margin-top:5px;
    font-family:var(--book-serif);
    font-size:16px;
    line-height:1.55;
  }
  .series-pager a:hover > b{color:var(--book-cinnabar)}
  .series-pager-next{text-align:right}
  .series-pager-empty{
    display:flex;
    min-height:62px;
    align-items:flex-start;
    color:var(--book-muted);
    font-size:13px;
  }
  .series-back{margin-top:30px}

  @media (max-width:700px){
    .catalog-labels{display:none}
    .catalog-row{grid-template-columns:36px minmax(0,1fr) auto;gap:12px;min-height:66px;padding:13px 0}
    .catalog-stars{display:none}
    .catalog-title{font-size:15.5px}
    .series-pager{grid-template-columns:1fr;gap:16px}
    .series-pager-next{text-align:left}
  }

  @media (max-width:600px){
    .series-catalog{padding-top:52px}
    .series-facts > div{grid-template-columns:90px minmax(0,1fr)}
  }
</style>
